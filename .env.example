# Local/dev defaults. Copy to .env for docker-compose, or export manually.
# NEVER commit a real .env with production secrets.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lifehub:lifehub@db:5432/lifehub
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=lifehub
POSTGRES_DB=lifehub

# Required in production; this is a local-only placeholder.
SESSION_SECRET_KEY=change-me-to-a-long-random-value
SESSION_COOKIE_NAME=lifehub_session
SESSION_TTL_HOURS=720
MIN_PASSWORD_LENGTH=10

CORS_ORIGINS=http://localhost:5173

# Optional: KitchenOwl adapter (leave unset to keep the integration disabled)
# To run a local KitchenOwl instance via the "kitchenowl" compose profile
# (docker compose --profile kitchenowl up -d), point these at the
# kitchenowl-frontend (nginx) service, which is the HTTP-speaking entry
# point into KitchenOwl's API (/api/... is reverse-proxied to the backend's
# raw uWSGI port). Do NOT point at kitchenowl-backend directly - its port
# speaks uWSGI, not HTTP, and requests will hang/fail silently:
#   KITCHENOWL_BASE_URL=http://kitchenowl-frontend/api
# Create the first KitchenOwl account/household via its onboarding flow
# (POST /api/onboarding with {"username","password","name"}, then
# POST /api/household with {"name"}) matching USERNAME/PASSWORD/HOUSEHOLD_ID
# below. Otherwise point at any existing self-hosted KitchenOwl instance's
# URL (include its own /api prefix).
KITCHENOWL_BASE_URL=
KITCHENOWL_USERNAME=
KITCHENOWL_PASSWORD=
KITCHENOWL_HOUSEHOLD_ID=

# Only needed when running the local "kitchenowl" compose profile (JWT
# signing secret for the kitchenowl-backend container). Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
KITCHENOWL_JWT_SECRET_KEY=

# Optional: meal assistant (chat about a dish -> auto-add ingredients to the
# KitchenOwl shopping list). Leave ASSISTANT_API_KEY unset to keep the
# feature disabled (GET /assistant/status will report configured=false).
# Works with any OpenAI-compatible chat completions API. Default provider is
# Groq (https://console.groq.com/keys) because it has a free tier with no
# credit card required; swap ASSISTANT_BASE_URL/ASSISTANT_MODEL to use
# OpenAI, Azure OpenAI, or a self-hosted model server instead.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=openai/gpt-oss-120b
# Model used only for chat turns that include an uploaded photo (vision-
# capable). Must support image inputs on the same OpenAI-compatible API,
# AND your provider account/API key must actually have access to it -
# Groq in particular only exposes vision models to some accounts/tiers,
# so a stale/wrong value here fails with a 502 "model not found" from the
# assistant, not a network error. Check what your key can use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $ASSISTANT_API_KEY"
# If no vision model is available on your Groq account, point
# ASSISTANT_BASE_URL/ASSISTANT_API_KEY/ASSISTANT_VISION_MODEL at another
# OpenAI-compatible provider instead (e.g. Google's Gemini has a free tier
# and an OpenAI-compatible endpoint at
# https://generativelanguage.googleapis.com/v1beta/openai/ with vision-
# capable models such as gemini-2.0-flash).
ASSISTANT_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: only needed if your network blocks the public package CDNs
# (files.pythonhosted.org / registry.npmjs.org), e.g. behind a corporate
# firewall that only allows an internal mirror. Leave unset to build with
# the public PyPI/npm registries (the default for everyone else).
# PIP_INDEX_URL=https://your-corporate-pypi-mirror/simple/
# NPM_REGISTRY=https://your-corporate-npm-mirror/
