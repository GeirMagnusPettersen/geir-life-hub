# Local/dev defaults. Copy to .env for docker-compose, or export manually.
# NEVER commit a real .env with production secrets.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lifehub:lifehub@db:5432/lifehub
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=lifehub
POSTGRES_DB=lifehub

# Required in production; this is a local-only placeholder.
SESSION_SECRET_KEY=change-me-to-a-long-random-value
SESSION_COOKIE_NAME=lifehub_session
SESSION_TTL_HOURS=720
MIN_PASSWORD_LENGTH=10

CORS_ORIGINS=http://localhost:5173

# Optional: KitchenOwl adapter (leave unset to keep the integration disabled)
KITCHENOWL_BASE_URL=
KITCHENOWL_USERNAME=
KITCHENOWL_PASSWORD=
KITCHENOWL_HOUSEHOLD_ID=
